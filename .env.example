# Environment Configuration
# Optional: Gemini API Key for fallback classification when keyword confidence is low/ambiguous
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Custom path to Tesseract OCR binary if not automatically on PATH
# e.g., C:\Program Files\Tesseract-OCR\tesseract.exe on Windows or /usr/bin/tesseract on Linux
TESSERACT_CMD=
